# Generated by pywal16 for Micro
# Do not edit the generated copy in ~/.config/micro/colorschemes/

color-link default "{foreground},{background}"

# Comments
color-link comment "#{color8.strip}"
color-link comment.bright "#{color14.strip}"

# Identifiers
color-link identifier "#{color6.strip}"
color-link identifier.class "#{color14.strip}"
color-link identifier.var "#{color6.strip}"
color-link identifier.macro "#{color13.strip}"

# Constants
color-link constant "#{color5.strip}"
color-link constant.number "#{color13.strip}"
color-link constant.bool "#{color13.strip}"
color-link constant.bool.true "#{color10.strip}"
color-link constant.bool.false "#{color9.strip}"
color-link constant.string "#{color2.strip}"
color-link constant.string.url "underline #{color4.strip}"
color-link constant.specialChar "#{color3.strip}"

# Symbols and operators
color-link symbol "#{color3.strip}"
color-link symbol.brackets "#{color7.strip}"
color-link symbol.operator "#{color9.strip}"
color-link symbol.tag "#{color4.strip}"

# Types and keywords
color-link type "#{color14.strip}"
color-link type.keyword "#{color5.strip}"
color-link statement "bold #{color4.strip}"
color-link preproc "#{color13.strip}"
color-link special "#{color12.strip}"

# Search and selection
color-link selection "#{color0.strip},#{color4.strip}"
color-link hlsearch "bold #{color0.strip},#{color3.strip}"
color-link tab-error "bold #{color0.strip},#{color1.strip}"
color-link trailingws "#{color0.strip},#{color1.strip}"

# Diagnostics
color-link error "bold #{color9.strip}"
color-link todo "bold #{color0.strip},#{color3.strip}"
color-link underlined "underline #{color12.strip}"

# Diff
color-link diff-added "#{color10.strip}"
color-link diff-modified "#{color3.strip}"
color-link diff-deleted "#{color9.strip}"

# UI
color-link gutter-error "#{color9.strip}"
color-link gutter-warning "#{color3.strip}"
color-link scrollbar "#{color8.strip}"
color-link statusline "{foreground},{color0}"
color-link tabbar "{foreground},{color0}"
color-link line-number "#{color8.strip}"
color-link current-line-number "bold #{color15.strip}"
color-link indent-char "#{color8.strip}"
color-link color-column "{color8},{background}"
color-link cursor-line "{background},{color8}"

color-link type.extended "default"
